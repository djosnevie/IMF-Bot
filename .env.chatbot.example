# ==============================================
# CHATBOT MADAME SOPHIE - CONFIGURATION
# ==============================================

# Chatbot Configuration
CHATBOT_NAME="Madame Sophie"
CHATBOT_AI_PROVIDER=openai  # Options: openai, gemini

# OpenAI Configuration (si vous utilisez OpenAI)
OPENAI_API_KEY=sk-votre_cle_api_openai_ici
OPENAI_MODEL=gpt-4  # ou gpt-3.5-turbo pour réduire les coûts

# Google Gemini Configuration (si vous utilisez Gemini)
GEMINI_API_KEY=votre_cle_api_gemini_ici
GEMINI_MODEL=gemini-pro

# WhatsApp Business API Configuration
# Obtenez ces valeurs depuis Meta Developer Console
WHATSAPP_VERIFY_TOKEN=bisou_bisou_webhook_token_2024
WHATSAPP_ACCESS_TOKEN=votre_access_token_whatsapp_ici
WHATSAPP_PHONE_NUMBER_ID=votre_phone_number_id_ici
WHATSAPP_APP_SECRET=votre_app_secret_ici

# Optional: Personnaliser le prompt système
# CHATBOT_SYSTEM_PROMPT="Votre prompt personnalisé..."
